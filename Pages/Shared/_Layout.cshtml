<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DuPharma</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Global Page Loading Overlay -->
    <div class="loading-overlay" id="pageLoader" style="display:none;">
        <div class="spinner-container">
            <div class="spinner"></div>
            <p class="loading-text">Loading...</p>
        </div>
    </div>

    <div class="d-flex">
        <!-- Mobile Overlay -->
        <div class="mobile-overlay" id="mobileOverlay"></div>

        <!-- Sidebar -->
        <nav class="sidebar">
            <div class="sidebar-header">
                <div class="logo">
                    <img src="~/DupharmaIcon.svg" alt="DuPharma" class="logo-icon-svg" />
                    <span class="logo-text">DuPharma</span>
                </div>
            </div>
            
            @if (User.Identity!.IsAuthenticated)
            {
                <ul class="sidebar-nav">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <span>Overview</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Medicines" asp-action="Index">
                            <span>Medicines</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Sales" asp-action="Index">
                            <span>Sales</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Customers" asp-action="Index">
                            <span>Customers</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Orders" asp-action="Index">
                            <span>Orders</span>
                        </a>
                    </li>
                    @if (User.IsInRole("Manager") || User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Batches" asp-action="Index">
                                <span>Batches</span>
                            </a>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Reports" asp-action="Index">
                            <span>Reports</span>
                        </a>
                    </li>
                    @if (User.IsInRole("Manager") || User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="ContactMessages" asp-action="Index">
                                <span>Contact Messages</span>
                                @await Component.InvokeAsync("PendingContactMessages")
                            </a>
                        </li>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Users" asp-action="Index">
                                <span>Users</span>
                            </a>
                        </li>
                    }
                </ul>
                
                <div class="sidebar-footer">
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="logout-btn">Logout</button>
                    </form>
                </div>
            }
        </nav>

        <!-- Main Content -->
        <div class="main-content">
            @if (User.Identity!.IsAuthenticated)
            {
                <header class="top-header">
                    <button class="hamburger-menu d-md-none" id="sidebarToggle">
                        <span class="hamburger-line"></span>
                        <span class="hamburger-line"></span>
                        <span class="hamburger-line"></span>
                    </button>
                    <div class="user-info">
                        <div class="user-details">
                            <div class="user-name">@User.Identity.Name</div>
                            <div class="user-role">@(User.IsInRole("Admin") ? "Admin" : User.IsInRole("Manager") ? "Manager" : "Pharmacist") @if(User.FindFirst("BranchId")?.Value != ""){ <span>| Branch: @User.FindFirst("BranchName")?.Value</span> }</div>
                        </div>
                    <div class="user-avatar">
                        @User.Identity.Name?.Substring(0, 2).ToUpper()
                    </div>
                    </div>
                </header>
            }
            
            <main class="content-area">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Show loading on all navigation clicks
        $(document).ready(function() {
            // Show loader on all link clicks
            $('a:not([target="_blank"]):not([href^="#"]):not([data-bs-toggle])').on('click', function(e) {
                if ($(this).attr('href') && $(this).attr('href') !== 'javascript:void(0)') {
                    $('#pageLoader').fadeIn(200);
                }
            });

            // Show loader on form submissions
            $('form:not([data-no-loader])').on('submit', function() {
                $('#pageLoader').fadeIn(200);
            });

            // Hide loader when page loads
            $(window).on('load', function() {
                $('#pageLoader').fadeOut(300);
            });

            // Hide loader if page doesn't navigate (back button, etc)
            setTimeout(function() {
                $('#pageLoader').fadeOut(300);
            }, 5000);
        });
    </script>
    @if (TempData["JwtToken"] != null)
    {
        <script>
            localStorage.setItem('token', '@TempData["JwtToken"]');
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>