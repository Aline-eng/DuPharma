@model DuPharma.Models.ContactMessage
@{
    ViewData["Title"] = "Delete Message";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-danger"><i class="bi bi-trash me-2"></i>Delete Message</h2>
        <a href="@Url.Action("Details", new { id = Model.Id })" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to Message
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Confirm Deletion</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <strong>Warning:</strong> This action cannot be undone. The message and any replies will be permanently deleted.
                    </div>

                    <h6>Message Details:</h6>
                    <div class="bg-light p-3 rounded mb-4">
                        <div class="row">
                            <div class="col-md-6">
                                <strong>From:</strong> @Model.FullName<br>
                                <strong>Email:</strong> @Model.Email<br>
                                @if (!string.IsNullOrEmpty(Model.Phone))
                                {
                                    <strong>Phone:</strong> @Model.Phone<br>
                                }
                                <strong>Date:</strong> @Model.CreatedAt.ToString("MMMM dd, yyyy 'at' HH:mm")
                            </div>
                            <div class="col-md-6">
                                <strong>Subject:</strong> @Model.Subject<br>
                                <strong>Status:</strong> 
                                @if (Model.IsReplied)
                                {
                                    <span class="badge bg-success">Replied</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Pending</span>
                                }
                            </div>
                        </div>
                        <div class="mt-3">
                            <strong>Message:</strong><br>
                            <div style="max-height: 150px; overflow-y: auto;">
                                @Model.Message
                            </div>
                        </div>
                        @if (Model.IsReplied && !string.IsNullOrEmpty(Model.Reply))
                        {
                            <div class="mt-3">
                                <strong>Reply:</strong><br>
                                <div class="bg-success bg-opacity-10 p-2 rounded" style="max-height: 100px; overflow-y: auto;">
                                    @Model.Reply
                                </div>
                            </div>
                        }
                    </div>

                    <div class="d-flex gap-2 justify-content-end">
                        <a href="@Url.Action("Details", new { id = Model.Id })" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                        <form asp-action="Delete" method="post" class="d-inline">
                            <input type="hidden" asp-for="Id">
                            <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this message? This action cannot be undone.')">
                                <i class="bi bi-trash"></i> Delete Message
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>