@model DuPharma.Models.ContactMessage
@{
    ViewData["Title"] = "Message Details";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-envelope-open me-2"></i>Message Details</h2>
        <div>
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to Inbox
            </a>
            @if (!Model.IsReplied)
            {
                <a href="@Url.Action("Reply", new { id = Model.Id })" class="btn btn-success">
                    <i class="bi bi-reply"></i> Reply
                </a>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">@Model.Subject</h5>
                    @if (Model.IsReplied)
                    {
                        <span class="badge bg-success">Replied</span>
                    }
                    else
                    {
                        <span class="badge bg-warning">Pending</span>
                    }
                </div>
                <div class="card-body">
                    <div class="mb-4">
                        <h6 class="text-muted">Original Message:</h6>
                        <div class="bg-light p-3 rounded">
                            <p class="mb-0" style="white-space: pre-wrap;">@Model.Message</p>
                        </div>
                    </div>

                    @if (Model.IsReplied && !string.IsNullOrEmpty(Model.Reply))
                    {
                        <div class="mb-4">
                            <h6 class="text-muted">Admin Reply:</h6>
                            <div class="bg-success bg-opacity-10 border-start border-success border-4 p-3 rounded">
                                <p class="mb-0" style="white-space: pre-wrap;">@Model.Reply</p>
                            </div>
                            <small class="text-muted">
                                Replied on @Model.RepliedAt?.ToString("MMMM dd, yyyy 'at' HH:mm")
                                @if (Model.RepliedByUser != null)
                                {
                                    <text> by @Model.RepliedByUser.FullName</text>
                                }
                            </small>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0">Contact Information</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <strong>Name:</strong><br>
                        @Model.FullName
                    </div>
                    <div class="mb-3">
                        <strong>Email:</strong><br>
                        <a href="mailto:@Model.Email">@Model.Email</a>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Phone))
                    {
                        <div class="mb-3">
                            <strong>Phone:</strong><br>
                            <a href="tel:@Model.Phone">@Model.Phone</a>
                        </div>
                    }
                    <div class="mb-3">
                        <strong>Received:</strong><br>
                        @Model.CreatedAt.ToString("MMMM dd, yyyy 'at' HH:mm")
                    </div>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header">
                    <h6 class="mb-0">Actions</h6>
                </div>
                <div class="card-body">
                    @if (!Model.IsReplied)
                    {
                        <a href="@Url.Action("Reply", new { id = Model.Id })" class="btn btn-success w-100 mb-2">
                            <i class="bi bi-reply"></i> Reply to Message
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("Reply", new { id = Model.Id })" class="btn btn-outline-success w-100 mb-2">
                            <i class="bi bi-reply"></i> Send Another Reply
                        </a>
                    }
                    <a href="@Url.Action("Delete", new { id = Model.Id })" class="btn btn-outline-danger w-100">
                        <i class="bi bi-trash"></i> Delete Message
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>