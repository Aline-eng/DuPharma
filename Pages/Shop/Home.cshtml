@{
    ViewData["Title"] = "Home";
    Layout = "~/Pages/Shared/_ShopLayout.cshtml";
}

<div class="hero-section" style="padding: 100px 0;">
    <div class="container text-center">
        <h1 class="display-3 fw-bold mb-4">Welcome to DuPharma Pharmacy</h1>
        <p class="lead mb-4">Your trusted partner in health and wellness</p>
        <div class="d-flex gap-3 justify-content-center">
            <a href="/Shop/Index" class="btn btn-primary btn-lg px-5 py-3">
                <i class="bi bi-capsule"></i> Browse Medicines
            </a>
            <a href="/Shop/Contact" class="btn btn-outline-light btn-lg px-5 py-3">
                <i class="bi bi-telephone"></i> Contact Us
            </a>
        </div>
    </div>
</div>

<div class="container my-5">
    <div class="row text-center mb-5">
        <div class="col-md-4 mb-4">
            <div class="p-4">
                <i class="bi bi-shield-check" style="font-size: 3rem; color: #3498db;"></i>
                <h4 class="mt-3">Quality Assured</h4>
                <p class="text-muted">All medicines are sourced from certified suppliers and stored properly</p>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="p-4">
                <i class="bi bi-truck" style="font-size: 3rem; color: #27ae60;"></i>
                <h4 class="mt-3">Fast Delivery</h4>
                <p class="text-muted">Quick and reliable delivery to your doorstep</p>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="p-4">
                <i class="bi bi-people" style="font-size: 3rem; color: #e74c3c;"></i>
                <h4 class="mt-3">Expert Support</h4>
                <p class="text-muted">Professional pharmacists available to assist you</p>
            </div>
        </div>
    </div>

    <div class="row align-items-center my-5">
        <div class="col-md-1 text-center">
            <i class="bi bi-capsule" style="font-size: 4rem; color: #3498db; opacity: 0.3;"></i>
        </div>
        <div class="col-md-10">
            <h2 class="mb-4 text-center">Why Choose DuPharma?</h2>
            <p class="mb-4">We are committed to providing the highest quality pharmaceutical products and services to our community. With years of experience in healthcare, our dedicated team of licensed pharmacists ensures that every customer receives personalized attention and expert guidance. We maintain strict quality standards, source medications from certified suppliers, and prioritize your health and well-being above all else.</p>
            <div class="row">
                <div class="col-md-6">
                    <ul class="list-unstyled">
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Wide range of medicines</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Competitive pricing</li>
                    </ul>
                </div>
                <div class="col-md-6">
                    <ul class="list-unstyled">
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Multiple branch locations</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Online ordering available</li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-md-1 text-center">
            <i class="bi bi-capsule-pill" style="font-size: 4rem; color: #27ae60; opacity: 0.3;"></i>
        </div>
    </div>

    <div class="row my-5">
        <div class="col-12 text-center mb-4">
            <h2>Featured Medicines</h2>
            <p class="text-muted">Browse our most popular products</p>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card h-100 shadow-sm">
                <img src="/images/paracetamol-panadol.jpg" class="card-img-top" alt="Panadol" style="height: 200px; object-fit: cover;">
                <div class="card-body text-center">
                    <h5 class="card-title">Panadol</h5>
                    <p class="text-muted small">Paracetamol 500mg</p>
                    <a href="/Shop/Details/1" class="btn btn-primary btn-sm">View Details</a>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card h-100 shadow-sm">
                <img src="/images/ibuprofen-advil.jpg" class="card-img-top" alt="Advil" style="height: 200px; object-fit: cover;">
                <div class="card-body text-center">
                    <h5 class="card-title">Advil</h5>
                    <p class="text-muted small">Ibuprofen 400mg</p>
                    <a href="/Shop/Details/2" class="btn btn-primary btn-sm">View Details</a>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card h-100 shadow-sm">
                <img src="/images/amoxicillin-amoxil.jpg" class="card-img-top" alt="Amoxil" style="height: 200px; object-fit: cover;">
                <div class="card-body text-center">
                    <h5 class="card-title">Amoxil</h5>
                    <p class="text-muted small">Amoxicillin 250mg</p>
                    <a href="/Shop/Details/3" class="btn btn-primary btn-sm">View Details</a>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card h-100 shadow-sm">
                <img src="/images/omeprazole-prilosec.jpg" class="card-img-top" alt="Prilosec" style="height: 200px; object-fit: cover;">
                <div class="card-body text-center">
                    <h5 class="card-title">Prilosec</h5>
                    <p class="text-muted small">Omeprazole 20mg</p>
                    <a href="/Shop/Details/4" class="btn btn-primary btn-sm">View Details</a>
                </div>
            </div>
        </div>
    </div>
</div>
