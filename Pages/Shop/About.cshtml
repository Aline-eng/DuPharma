@{
    ViewData["Title"] = "About Us";
    Layout = "~/Pages/Shared/_ShopLayout.cshtml";
}

<div class="hero-section" style="padding: 80px 0;">
    <div class="container text-center">
        <h1 class="display-4 fw-bold">About DuPharma Pharmacy</h1>
        <p class="lead">Committed to your health and wellness since 2024</p>
    </div>
</div>

<div class="container my-5">
    <div class="row mb-5">
        <div class="col-md-12">
            <h2 class="mb-4">Our Story</h2>
            <p class="lead">DuPharma Pharmacy is a trusted healthcare provider dedicated to serving our community with quality pharmaceutical products and professional services.</p>
            <p>We understand that health is wealth, and we are committed to ensuring that every customer receives the best care possible. Our team of experienced pharmacists and healthcare professionals work tirelessly to provide accurate information, quality products, and exceptional service.</p>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-md-4 mb-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <i class="bi bi-bullseye" style="font-size: 3rem; color: #3498db;"></i>
                    <h4 class="mt-3">Our Mission</h4>
                    <p class="text-muted">To provide accessible, affordable, and quality healthcare products to our community while maintaining the highest standards of pharmaceutical care.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <i class="bi bi-eye" style="font-size: 3rem; color: #27ae60;"></i>
                    <h4 class="mt-3">Our Vision</h4>
                    <p class="text-muted">To be the leading pharmacy chain recognized for excellence in pharmaceutical care, customer service, and community health initiatives.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <i class="bi bi-heart" style="font-size: 3rem; color: #e74c3c;"></i>
                    <h4 class="mt-3">Our Values</h4>
                    <p class="text-muted">Integrity, professionalism, compassion, and commitment to excellence in everything we do for our customers.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-md-12">
            <h2 class="mb-4">Our Branches</h2>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title"><i class="bi bi-geo-alt-fill text-primary"></i> Main Branch</h5>
                            <p class="card-text">Downtown<br>Open: Mon-Sat, 8AM - 10PM</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title"><i class="bi bi-geo-alt-fill text-primary"></i> North Branch</h5>
                            <p class="card-text">North District<br>Open: Mon-Sat, 8AM - 10PM</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title"><i class="bi bi-geo-alt-fill text-primary"></i> South Branch</h5>
                            <p class="card-text">South District<br>Open: Mon-Sat, 8AM - 10PM</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
