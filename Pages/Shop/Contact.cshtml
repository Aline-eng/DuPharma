@model DuPharma.Models.ContactFormViewModel
@{
    ViewData["Title"] = "Contact Us";
    Layout = "~/Pages/Shared/_ShopLayout.cshtml";
}

<div class="hero-section" style="padding: 80px 0;">
    <div class="container text-center">
        <h1 class="display-4 fw-bold">Contact Us</h1>
        <p class="lead">We're here to help. Reach out to us anytime!</p>
    </div>
</div>

<div class="container mt-3">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>Please check the form fields below.
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
</div>

<div class="container my-5">
    <div class="row">
        <div class="col-md-6 mb-4">
            <h2 class="mb-4">Get In Touch</h2>
            <p class="mb-4">Have questions about our products or services? Feel free to contact us using the information below or fill out the contact form.</p>
            
            <div class="mb-4">
                <h5><i class="bi bi-geo-alt-fill text-primary me-2"></i> Address</h5>
                <p class="text-muted">123 Medical Street, Health City</p>
            </div>
            
            <div class="mb-4">
                <h5><i class="bi bi-telephone-fill text-primary me-2"></i> Phone</h5>
                <p class="text-muted">+250 789 252 719</p>
            </div>
            
            <div class="mb-4">
                <h5><i class="bi bi-envelope-fill text-primary me-2"></i> Email</h5>
                <p class="text-muted">info@dupharma.com</p>
            </div>
            
            <div class="mb-4">
                <h5><i class="bi bi-clock-fill text-primary me-2"></i> Business Hours</h5>
                <p class="text-muted">Monday - Saturday: 8:00 AM - 10:00 PM<br>Sunday: Closed</p>
            </div>
        </div>
        
        <div class="col-md-6 mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h3 class="mb-4">Send Us a Message</h3>
                    <form asp-controller="Shop" asp-action="Contact" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <!-- Anti-bot honeypot field (hidden) -->
                        <div style="position: absolute; left: -9999px; top: -9999px;">
                            <input name="HoneyPot" type="text" tabindex="-1" autocomplete="off" inert>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label">Full Name <span class="text-danger">*</span></label>
                            <input asp-for="FullName" class="form-control" placeholder="Enter your name">
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email Address <span class="text-danger">*</span></label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="Enter your email">
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label">Phone Number</label>
                            <input asp-for="Phone" type="tel" class="form-control" placeholder="Enter your phone">
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Subject" class="form-label">Subject <span class="text-danger">*</span></label>
                            <input asp-for="Subject" class="form-control" placeholder="Enter subject">
                            <span asp-validation-for="Subject" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Message" class="form-label">Message <span class="text-danger">*</span></label>
                            <textarea asp-for="Message" class="form-control" rows="4" placeholder="Enter your message"></textarea>
                            <span asp-validation-for="Message" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-send me-2"></i>Send Message
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row mt-5">
        <div class="col-md-12">
            <h2 class="mb-4 text-center">Visit Our Branches</h2>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <div class="card-body text-center">
                            <i class="bi bi-building" style="font-size: 2.5rem; color: #3498db;"></i>
                            <h5 class="mt-3">Main Branch</h5>
                            <p class="text-muted mb-2">Downtown</p>
                            <p class="small">123 Medical Street<br>Phone: +250 789 252 719</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <div class="card-body text-center">
                            <i class="bi bi-building" style="font-size: 2.5rem; color: #27ae60;"></i>
                            <h5 class="mt-3">North Branch</h5>
                            <p class="text-muted mb-2">North District</p>
                            <p class="small">456 Health Avenue<br>Phone: +250 780 142 700</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <div class="card-body text-center">
                            <i class="bi bi-building" style="font-size: 2.5rem; color: #e74c3c;"></i>
                            <h5 class="mt-3">South Branch</h5>
                            <p class="text-muted mb-2">South District</p>
                            <p class="small">789 Wellness Boulevard<br>Phone: +250 788 242 719</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            $('form').on('submit', function() {
                console.log('Form submit event triggered');
                var submitBtn = $(this).find('button[type="submit"]');
                submitBtn.prop('disabled', true);
                submitBtn.html('<i class="bi bi-hourglass-split me-2"></i>Sending...');

                // Reset button after 10 seconds if no response
                setTimeout(function() {
                    submitBtn.prop('disabled', false);
                    submitBtn.html('<i class="bi bi-send me-2"></i>Send Message');
                }, 10000);
            });
        });
    </script>
}
